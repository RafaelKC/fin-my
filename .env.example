# Copie para `.env` (não versionado): cp .env.example .env
# Todos os valores abaixo são apenas para desenvolvimento local — troque em produção.

# --- PostgreSQL (serviço `db`) ---
POSTGRES_DB=finmy
POSTGRES_USER=finmy
POSTGRES_PASSWORD=finmy_dev_password

# --- API ---
# Connection string usada pela API (host `db` = serviço do compose).
# Se mudar as credenciais acima, mantenha-as iguais aqui.
ConnectionStrings__Default=Host=db;Port=5432;Database=finmy;Username=finmy;Password=finmy_dev_password

# Chave de assinatura do JWT (mínimo 32 caracteres). Gere uma nova: openssl rand -base64 48
Jwt__SigningKey=dev-only-change-me-dev-only-change-me-0123456789

# SMTP (em dev, aponta para o Mailpit do docker-compose.dev.yml)
Smtp__Host=mailpit
Smtp__Port=1025
Smtp__User=
Smtp__Password=
Smtp__UseSsl=false
Smtp__From=no-reply@finmy.local

# URL pública do app; usada nos links dos e-mails ({APP_URL}/redefinir-senha?token=...)
APP_URL=http://localhost:8080

# --- Portas publicadas no host ---
# Única porta exposta pelo compose base (serviço `web`).
WEB_PORT=8080
