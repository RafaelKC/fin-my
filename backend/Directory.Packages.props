<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Persistência -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.4" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <!-- Aplicação / infraestrutura -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="MailKit" Version="5.0.0" />
    <PackageVersion Include="Hangfire.Core" Version="1.8.25" />
    <PackageVersion Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageVersion Include="Hangfire.PostgreSql" Version="1.21.1" />
    <!-- Hangfire.Core 1.8 traz Newtonsoft.Json 11.0.1 (vulnerável, NU1903): fixado numa versão corrigida -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Autenticação (001): JwtBearer (o PasswordHasher já vem no framework compartilhado) -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <!-- OAuth 2.1 do conector do Claude (008): servidor + validação (OpenIddict) com as tabelas no EF Core -->
    <PackageVersion Include="OpenIddict.AspNetCore" Version="7.9.0" />
    <PackageVersion Include="OpenIddict.EntityFrameworkCore" Version="7.9.0" />
    <!-- Servidor MCP do conector do Claude (008): SDK oficial para C# (Streamable HTTP) -->
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="1.1.0" />
    <!-- OpenAPI gerado pela própria API (docs/arquitetura.md §2); a suíte de isolamento descobre as operações por ele -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <!-- Testes -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
  </ItemGroup>
</Project>
