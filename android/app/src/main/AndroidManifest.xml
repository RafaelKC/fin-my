<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FinMy">

        <!--
            App Capacitor (010): a WebView carrega o site (server.url = finmy.appUrl), com o mesmo login por cookie.
            Links do widget e dos atalhos chegam como VIEW com a URL do site.
        -->
        <activity
            android:name="br.app.finmy.MainActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.FinMy">
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Widget "Fatura do cartão" (009 T004). -->
        <receiver
            android:name="br.app.finmy.widget.FaturaWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/fatura_widget_info" />
        </receiver>

        <!-- Relógio (010): atende os pedidos do app do Wear OS (Data Layer, RPC). -->
        <service
            android:name="br.app.finmy.wear.PhoneBridgeService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.REQUEST_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/finmy" />
            </intent-filter>
        </service>

        <!-- Widgets de resumo e o atalho Lançar (010). -->
        <receiver
            android:name="br.app.finmy.widget.MesWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_mes_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mes_widget_info" />
        </receiver>

        <receiver
            android:name="br.app.finmy.widget.VencimentosWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_vencimentos_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/vencimentos_widget_info" />
        </receiver>

        <receiver
            android:name="br.app.finmy.widget.AcertosWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_acertos_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/acertos_widget_info" />
        </receiver>

        <receiver
            android:name="br.app.finmy.widget.LancarWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_lancar_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lancar_widget_info" />
        </receiver>

        <!-- O sistema abre a configuração ao adicionar o widget. -->
        <activity
            android:name="br.app.finmy.widget.WidgetConfigActivity"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

    </application>
</manifest>
